{
  "name": "verification-driven-ai-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test:properties": "node --test dist/test/booking.test.js",
    "test:constructors": "node --test dist/test/interval.test.js",
    "test": "npm run build && (npm run test:properties; properties=$?; npm run test:constructors; constructors=$?; test $properties -eq 0 -a $constructors -eq 0)"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@types/node": "^24.0.0",
    "fast-check": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
